Cell["\<\
Determining equivalency between the different expressions for the coupled \
Free Energy
There are two expressions for the coupled entropy that need to equal each \
other\
\>", "Text",
 CellChangeTimes->{{3.976705998556727*^9, 3.976706016464118*^9}, {
  3.97670642039369*^9, 
  3.9767064487177763`*^9}},ExpressionUUID->"edc2d679-0e2c-4740-a8b1-\
e6bdb7907a5d"],

Cell[BoxData[
 RowBox[{"S\[Kappa]", " ", "=", " ", 
  RowBox[{
   FractionBox["U\[Kappa]", "T\[Kappa]M"], "+", " ", 
   RowBox[{"CoupledLogarithm", "[", 
    RowBox[{
     SuperscriptBox["Z", 
      FractionBox["1", 
       RowBox[{"1", "+", "\[Kappa]"}]]], ",", "\[Kappa]", ",", "0"}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.976706453154901*^9, 
  3.976706549318075*^9}},ExpressionUUID->"7270f6c2-2c21-4086-9970-\
7e54316c4d35"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "T\[Kappa]M"], " ", "=", " ", 
  RowBox[{
   FractionBox["S\[Kappa]", "U\[Kappa]"], "-", 
   RowBox[{"CoupledLogarithm", "[", 
    RowBox[{
     SuperscriptBox["Z", 
      FractionBox["1", 
       RowBox[{"1", "+", "\[Kappa]"}]]], ",", "\[Kappa]", ",", "0"}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.976706781810624*^9, 
  3.9767068395869102`*^9}},ExpressionUUID->"e9a8e41e-c641-4f92-b66c-\
cb47248f4089"],

Cell[TextData[{
 "Show that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox["1", "T\[Kappa]M"], ")"}], 
     RowBox[{"1", "+", "\[Kappa]"}]], "=", 
    RowBox[{
     FractionBox["1", "T\[Kappa]C"], "=", 
     RowBox[{
      FractionBox["S\[Kappa]", "U\[Kappa]"], 
      SubscriptBox["\[CircleMinus]", "\[Kappa]"], 
      RowBox[{"CoupledLogarithm", "[", 
       RowBox[{
        SuperscriptBox["Z", 
         FractionBox["1", 
          RowBox[{"1", "+", "\[Kappa]"}]]], ",", "\[Kappa]", ",", "0"}], 
       "]"}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1689f5b1-80f1-4d11-bf86-af505524c65d"]
}], "Text",
 CellChangeTimes->{{3.976706861582863*^9, 
  3.976706978320764*^9}},ExpressionUUID->"352804df-ea35-43d3-8741-\
1c33c50392fb"],

Cell[BoxData[
 SuperscriptBox[
  RowBox[{"(", 
   RowBox[{
    FractionBox["S\[Kappa]", "U\[Kappa]"], "-", 
    RowBox[{"CoupledLogarithm", "[", 
     RowBox[{
