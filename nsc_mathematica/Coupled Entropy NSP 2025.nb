Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Assuming", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Kappa]", ">", "0"}], "&&", 
     RowBox[{"d", ">", "0"}], "&&", 
     RowBox[{"\[Alpha]", ">", "0"}], "&&", 
     RowBox[{"\[Gamma]", ">", "0"}], "&&", 
     RowBox[{"\[Kappa]", "\[Element]", "Reals"}], "&&", 
     RowBox[{"d", "\[Element]", "Reals"}], "&&", 
