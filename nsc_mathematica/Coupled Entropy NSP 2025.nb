Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"-", 
   RowBox[{
    SubsuperscriptBox["\[Integral]", "0", "\[Infinity]"], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", "\[Kappa]"}], ")"}], " ", 
       SuperscriptBox["\[Sigma]", 
        RowBox[{"1", "+", 
         FractionBox["1", "\[Kappa]"]}]], " ", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{"x", " ", "\[Kappa]"}], "+", "\[Sigma]"}], ")"}], 
        RowBox[{
         RowBox[{"-", "2"}], "-", 
         FractionBox["1", "\[Kappa]"]}]]}], ")"}], 
     RowBox[{"(", 
      FractionBox[
       RowBox[{"1", "-", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["\[Sigma]", 
            FractionBox["1", "\[Kappa]"]], " ", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              RowBox[{"x", " ", "\[Kappa]"}], "+", "\[Sigma]"}], ")"}], 
            RowBox[{"-", 
             FractionBox[
              RowBox[{"1", "+", "\[Kappa]"}], "\[Kappa]"]}]]}], ")"}], 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          FractionBox["1", 
           RowBox[{"1", "+", "\[Kappa]"}]]}]]}], "\[Kappa]"], ")"}], 
     RowBox[{"\[DifferentialD]", "x"}]}]}]}], "//", "FullSimplify"}]], "Input",\

 CellChangeTimes->{{3.6521971763689528`*^9, 3.652197204151492*^9}, {
