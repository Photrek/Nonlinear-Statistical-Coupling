Cell[CellGroupData[{

Cell["Uncertainty at the Scale: Definition for Gen. Entropy", "Subsection",
 CellChangeTimes->{{3.972291768975898*^9, 
  3.9722917846065893`*^9}},ExpressionUUID->"70b7603d-88f6-42c5-ab87-\
3d9565eb0e68"],

Cell[TextData[{
 "Since the generalized entropy must compute a solution that is equal to the \
generalized logarithm of the coupled stretched exponential distribution at \
the scale, it is illustrative to compute this value for a variety of \
generalized entropies. For simplicity the case of d=1, \[Alpha] = 1, and \
\[Mu] = 0 is computed. The entropy transformed to the domain of the \
distribution is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     SubscriptBox["exp", "\[Kappa]"], 
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{"1", "+", "\[Kappa]"}], ")"}]}]], "[", "H", "]"}], 
   TraditionalForm]],ExpressionUUID->"53a13350-d0bc-45ab-a471-7e56a0b9ae23"],
 ". This value must be set equal to f(x) and then one must solve for x, which \
requires taking ln_\[Kappa] ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"f", "(", "x", ")"}], 
    RowBox[{"-", "1"}]], TraditionalForm]],ExpressionUUID->
  "a376f3cd-4e79-4851-89c3-c8b7d5d8ed0a"],
 ", reversing the coupled exponential.  So the equation setting H equal to \
the argument of the density.  ",
 StyleBox[" ",
  NotebookAutoSave->True],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     SubscriptBox["exp", "\[Kappa]"], 
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{"1", "+", "\[Kappa]"}], ")"}]}]], "[", "H", "]"}], 
   TraditionalForm]],ExpressionUUID->"3190fc78-ba81-41fd-a241-106a96f13ee7"],
 " = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     SubscriptBox["exp", "\[Kappa]"], 
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{"1", "+", "\[Kappa]"}], ")"}]}]], "[", 
    RowBox[{
     FractionBox["x", "\[Sigma]"], "+", 
     RowBox[{
      SubscriptBox["ln", "\[Kappa]"], 
      SuperscriptBox["\[Sigma]", 
       FractionBox["1", 
        RowBox[{"1", "+", "\[Kappa]"}]]]}], "+", 
     RowBox[{"\[Kappa]", 
      FractionBox["x", "\[Sigma]"], 
      SubscriptBox["ln", "\[Kappa]"], 
      SuperscriptBox["\[Sigma]", 
       FractionBox["1", 
        RowBox[{"1", "+", "\[Kappa]"}]]]}]}], "]"}], TraditionalForm]],
  ExpressionUUID->"6cc8f87d-151d-4b78-a62c-3cf38a608d63"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"H", "=", 
    RowBox[{
     RowBox[{
      FractionBox["x", "\[Sigma]"], 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"\[Kappa]", " ", 
         SubscriptBox["ln", "\[Kappa]"], 
         SuperscriptBox["\[Sigma]", 
          FractionBox["1", 
           RowBox[{"1", "+", "\[Kappa]"}]]]}]}], ")"}]}], "+", 
     RowBox[{
      SubscriptBox["ln", "\[Kappa]"], 
      SuperscriptBox["\[Sigma]", 
       FractionBox["1", 
        RowBox[{"1", "+", "\[Kappa]"}]]]}]}]}], TraditionalForm]],
  ExpressionUUID->"dc6c83ed-e028-4af2-bb6e-31c59f373392"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["x", "\[Sigma]"], "=", 
    FractionBox[
     RowBox[{"\[Sigma]", "(", 
      RowBox[{"H", "-", 
       RowBox[{
        SubscriptBox["ln", "\[Kappa]"], 
        SuperscriptBox["\[Sigma]", 
         FractionBox["1", 
          RowBox[{"1", "+", "\[Kappa]"}]]]}]}], ")"}], 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"\[Kappa]", " ", 
        SubscriptBox["ln", "\[Kappa]"], 
        SuperscriptBox["\[Sigma]", 
         FractionBox["1", 
          RowBox[{"1", "+", "\[Kappa]"}]]]}]}], ")"}]]}], TraditionalForm]],
  ExpressionUUID->"31bc36fe-1a0f-4bb1-9d48-1051090f8daa"]
}], "Text",
 CellChangeTimes->{{3.9722917946582193`*^9, 3.972291884160562*^9}, {
  3.972291967905414*^9, 3.972291989493762*^9}, {3.9722921907471447`*^9, 
  3.972292391461537*^9}, {3.97229245302281*^9, 3.972292798576043*^9}, {
  3.9723332167648706`*^9, 3.972333537622559*^9}, {3.9765333696921*^9, 
  3.976533393587347*^9}},ExpressionUUID->"89c882a8-5ea6-4fcf-a888-\
8c176fb9fd18"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"entValue", "[", 
    RowBox[{"H_", ",", "\[Sigma]_", ",", "\[Kappa]_"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Sigma]", 
     FractionBox[
      RowBox[{"(", 
       RowBox[{"H", "-", 
        RowBox[{"CoupledLogarithm", "[", 
         RowBox[{
          SuperscriptBox["\[Sigma]", 
           FractionBox["1", 
            RowBox[{"1", "+", "\[Kappa]"}]]], ",", "\[Kappa]", ",", "0"}], 
         "]"}]}], ")"}], 
      RowBox[{"1", "+", 
       RowBox[{"\[Kappa]", " ", 
        RowBox[{"CoupledLogarithm", "[", 
         RowBox[{
          SuperscriptBox["\[Sigma]", 
           FractionBox["1", 
            RowBox[{"1", "+", "\[Kappa]"}]]], ",", "\[Kappa]", ",", "0"}], 
         "]"}]}]}]]}], "//", "FullSimplify"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.972334186416519*^9, 3.9723342749151154`*^9}, {
  3.972334897722126*^9, 3.972334904013665*^9}},
 CellLabel->"In[72]:=",ExpressionUUID->"a87d4202-c790-44d5-8324-71b98017e2ec"],

