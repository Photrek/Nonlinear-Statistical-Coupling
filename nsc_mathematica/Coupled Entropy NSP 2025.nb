Cell["\<\
So the use of the Generalized Weibull will require care regarding the \
definition for the scale of the distribution\
\>", "Text",
 CellChangeTimes->{{3.9621813731970987`*^9, 
  3.962181430238207*^9}},ExpressionUUID->"3ce7c5a5-e752-418a-9838-\
9634a10fd632"],

Cell["If \[Alpha] = 2, then", "Text",
 CellChangeTimes->{{3.9621814557175217`*^9, 
  3.962181467095264*^9}},ExpressionUUID->"ef808749-3d54-4f8e-b2d1-\
a4fde26438c0"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "\[Sigma]"], 
  FractionBox["\[Kappa]", 
   RowBox[{"1", "+", "\[Kappa]"}]]}]], "Input",
 CellChangeTimes->{{3.962181474519102*^9, 
  3.9621815021360292`*^9}},ExpressionUUID->"741fd8b9-a60f-4295-ae9a-\
de42bfae4916"],

Cell["\<\
So if this is defined as \[Sigma]W let\[CloseCurlyQuote]s see what happens.  \
Could also do this generally for alpha.\
\>", "Text",
 CellChangeTimes->{{3.962181544323601*^9, 3.962181580481345*^9}, {
  3.962181626285367*^9, 
  3.962181634886428*^9}},ExpressionUUID->"115e85e2-7335-4caf-86f0-\
bbe070a0f84f"],

Cell[CellGroupData[{

Cell[BoxData[
 FractionBox["1", 
  FractionBox[
   RowBox[{"2", "-", "\[Alpha]", "+", "\[Kappa]"}], 
   RowBox[{"\[Sigma]", "+", 
    RowBox[{"\[Kappa]", " ", "\[Sigma]"}]}]]]], "Input",
 CellChangeTimes->{{3.962181687283256*^9, 3.9621816961358223`*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"ead659d3-5ce4-42c5-940b-b5b22fd1e1f9"],

Cell[BoxData[
 FractionBox[
  RowBox[{"\[Sigma]", "+", 
   RowBox[{"\[Kappa]", " ", "\[Sigma]"}]}], 
  RowBox[{"2", "-", "\[Alpha]", "+", "\[Kappa]"}]]], "Output",
 CellChangeTimes->{3.962181700696891*^9},
 CellLabel->"Out[12]=",ExpressionUUID->"b10c7618-6431-4aaa-a125-88f276da6859"]
}, Closed]],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Sigma]W", "=", 
   FractionBox[
    RowBox[{"\[Sigma]", "+", 
     RowBox[{"\[Kappa]", " ", "\[Sigma]"}]}], 
    RowBox[{"2", "-", "\[Alpha]", "+", "\[Kappa]"}]]}], ";"}]], "Input",
 CellChangeTimes->{{3.962181641659539*^9, 3.962181653464003*^9}, {
  3.962181708124181*^9, 3.9621817094851837`*^9}},
 CellLabel->"In[13]:=",ExpressionUUID->"8f7f1062-f274-453b-b1c1-2c9199926216"],

Cell[TextData[{
 "Recompute the derivative using the expression - ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     RowBox[{"f", "'"}], 
     RowBox[{"(", "x", ")"}]}], 
    RowBox[{"f", "(", "x", ")"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "66bb8a85-a331-44f4-86f2-4b852dc2280c"]
}], "Text",
 CellChangeTimes->{{3.96580011748435*^9, 
  3.965800142208246*^9}},ExpressionUUID->"c05ae61c-0929-4958-ba05-\
b2d250a5ecc7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"D", "[", 
   RowBox[{
    RowBox[{
     SuperscriptBox["x", 
      RowBox[{
       RowBox[{"-", "1"}], "+", "\[Alpha]"}]], " ", 
     SuperscriptBox["\[Sigma]", 
      RowBox[{"-", "\[Alpha]"}]], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{
         SuperscriptBox["x", "\[Alpha]"], " ", "\[Kappa]", " ", 
         SuperscriptBox["\[Sigma]", 
          RowBox[{"-", "\[Alpha]"}]]}]}], ")"}], 
      RowBox[{
       RowBox[{"-", "1"}], "-", 
       FractionBox["1", 
        RowBox[{"\[Alpha]", " ", "\[Kappa]"}]]}]]}], ",", "x"}], "]"}], "//", 
  "FullSimplify"}]], "Input",
 CellChangeTimes->{{3.9658001507337646`*^9, 3.96580016346309*^9}},
 CellLabel->"In[90]:=",ExpressionUUID->"59f26807-b457-43c7-bf9b-e1b7a744ffd9"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["x", 
   RowBox[{
    RowBox[{"-", "2"}], "+", "\[Alpha]"}]], " ", 
  SuperscriptBox["\[Sigma]", 
   FractionBox["1", "\[Kappa]"]], " ", 
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      SuperscriptBox["x", "\[Alpha]"], " ", "\[Kappa]"}], "+", 
     SuperscriptBox["\[Sigma]", "\[Alpha]"]}], ")"}], 
   RowBox[{
    RowBox[{"-", "2"}], "-", 
    FractionBox["1", 
     RowBox[{"\[Alpha]", " ", "\[Kappa]"}]]}]], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      SuperscriptBox["x", "\[Alpha]"]}], " ", 
     RowBox[{"(", 
      RowBox[{"1", "+", "\[Kappa]"}], ")"}]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "+", "\[Alpha]"}], ")"}], " ", 
     SuperscriptBox["\[Sigma]", "\[Alpha]"]}]}], ")"}]}]], "Output",
 CellChangeTimes->{{3.9658001583829823`*^9, 3.965800166508675*^9}},
 CellLabel->"Out[90]=",ExpressionUUID->"b78e41d0-45b8-430c-a34d-0b1773d3febf"]
}, Closed]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"-", 
   FractionBox[
    RowBox[{
     SuperscriptBox["x", 
      RowBox[{
       RowBox[{"-", "2"}], "+", "\[Alpha]"}]], " ", 
     SuperscriptBox["\[Sigma]", 
      FractionBox["1", "\[Kappa]"]], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SuperscriptBox["x", "\[Alpha]"], " ", "\[Kappa]"}], "+", 
        SuperscriptBox["\[Sigma]", "\[Alpha]"]}], ")"}], 
      RowBox[{
       RowBox[{"-", "2"}], "-", 
       FractionBox["1", 
        RowBox[{"\[Alpha]", " ", "\[Kappa]"}]]}]], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         SuperscriptBox["x", "\[Alpha]"]}], " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", "\[Kappa]"}], ")"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", "\[Alpha]"}], ")"}], " ", 
        SuperscriptBox["\[Sigma]", "\[Alpha]"]}]}], ")"}]}], 
    RowBox[{
     SuperscriptBox["x", 
      RowBox[{
       RowBox[{"-", "1"}], "+", "\[Alpha]"}]], " ", 
