Cell[CellGroupData[{

Cell[TextData[{
 "Compute Tsallis Entropy with different ",
 StyleBox["q",
  FontSlant->"Italic"],
 " values"
}], "Subsubsection",
 CellChangeTimes->{{3.9651069387991743`*^9, 
  3.965106968348049*^9}},ExpressionUUID->"9fdcb386-f4f8-49cc-bdf8-\
32e23729cd7e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"$Assumptions", "=", 
  RowBox[{
   RowBox[{"\[Kappa]", "\[Element]", "Reals"}], "&&", 
   RowBox[{"0", "<", "\[Kappa]", "<", "\[Infinity]"}], "&&", 
   RowBox[{"\[Alpha]", "\[Element]", "Reals"}], "&&", 
   RowBox[{"0", "<", "\[Alpha]", "<", "\[Infinity]"}], "&&", 
   RowBox[{"d", "\[Element]", "Reals"}], "&&", 
   RowBox[{"0", "<", "d", "<", "\[Infinity]"}], "&&", 
   RowBox[{"\[Sigma]", "\[Element]", "Reals"}], "&&", 
   RowBox[{"0", "<", "\[Sigma]", "<", "\[Infinity]"}]}]}]], "Input",
 CellChangeTimes->{{3.965107013007945*^9, 3.9651071200359573`*^9}, {
  3.965111418927875*^9, 3.9651114304626303`*^9}},
 CellLabel->"In[83]:=",ExpressionUUID->"f2871f04-c60d-4286-947c-162d30c5abad"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Kappa]", "\[Element]", 
   TemplateBox[{},
    "Reals"]}], "&&", 
  RowBox[{"0", "<", "\[Kappa]", "<", "\[Infinity]"}], "&&", 
  RowBox[{"\[Alpha]", "\[Element]", 
   TemplateBox[{},
    "Reals"]}], "&&", 
  RowBox[{"0", "<", "\[Alpha]", "<", "\[Infinity]"}], "&&", 
  RowBox[{"d", "\[Element]", 
   TemplateBox[{},
    "Reals"]}], "&&", 
  RowBox[{"0", "<", "d", "<", "\[Infinity]"}], "&&", 
  RowBox[{"\[Sigma]", "\[Element]", 
   TemplateBox[{},
    "Reals"]}], "&&", 
  RowBox[{"0", "<", "\[Sigma]", "<", "\[Infinity]"}]}]], "Output",
 CellChangeTimes->{3.965108353644292*^9, 3.9651114317337437`*^9},
 CellLabel->"Out[83]=",ExpressionUUID->"bb043240-3844-42db-a101-bea9ae707038"]
}, Closed]],

Cell[TextData[{
 "qEnt = ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "qDist"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "340797bc-282c-4c7b-bd51-e69cf0917f89"]
}], "Text",
 CellChangeTimes->{{3.96510737355202*^9, 
  3.9651073872625227`*^9}},ExpressionUUID->"eb27dcd6-ead0-4005-8a03-\
eb95c21a259a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SubsuperscriptBox["\[Integral]", "0", "\[Infinity]"], 
   RowBox[{
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      FractionBox["1", "\[Sigma]"], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "+", 
         FractionBox[
          RowBox[{"\[Kappa]", " ", "x"}], "\[Sigma]"]}], ")"}], 
       RowBox[{"-", 
        FractionBox[
         RowBox[{"1", "+", " ", "\[Kappa]"}], "\[Kappa]"]}]], 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"qToCoupling", "[", 
         FractionBox[
          RowBox[{"1", "+", "\[Kappa]"}], 
          RowBox[{"1", "+", 
           RowBox[{"2", "\[Kappa]"}]}]], "]"}]}], ")"}], 
      RowBox[{"CoupledLogarithm", "[", 
       RowBox[{
        RowBox[{"\[Sigma]", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"1", "+", 
            FractionBox[
             RowBox[{"\[Kappa]", " ", "x"}], "\[Sigma]"]}], ")"}], 
          FractionBox[
           RowBox[{"1", "+", "\[Kappa]"}], "\[Kappa]"]]}], ",", 
        RowBox[{"qToCoupling", "[", 
         FractionBox[
          RowBox[{"1", "+", "\[Kappa]"}], 
          RowBox[{"1", "+", 
           RowBox[{"2", "\[Kappa]"}]}]], "]"}], ",", "1"}], "]"}]}], "]"}], 
