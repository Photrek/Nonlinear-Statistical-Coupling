e56b1ed8ddc4"],

Cell[BoxData[
 RowBox[{
  FractionBox[
   RowBox[{"1", "+", 
    RowBox[{"d", " ", "\[Kappa]"}]}], 
   RowBox[{"\[Alpha]", " ", "d", " ", 
    RowBox[{"\[Kappa]", "/", "\[Gamma]"}]}]], "=", 
  RowBox[{
   FractionBox["\[Gamma]", 
    RowBox[{"\[Alpha]", " ", "d", " ", "\[Kappa]"}]], "+", 
