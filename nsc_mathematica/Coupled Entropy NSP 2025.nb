Cell[CellGroupData[{

Cell["Taylor series of cdFunction", "Subsection",
 CellChangeTimes->{{3.9700423381401443`*^9, 
  3.970042346712406*^9}},ExpressionUUID->"960bfc1e-8011-477b-9b1a-\
ee16895387c6"],

Cell["Starting with the 0th branch which corresponds to d>0", "Text",
 CellChangeTimes->{{3.9700427144419937`*^9, 
  3.970042733511427*^9}},ExpressionUUID->"63d96a34-c7bf-41c7-83ce-\
d88ad403a268"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"cdFuntion", "[", 
    RowBox[{"x_", ",", "c_", ",", "d_", ",", "r_"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{
      FractionBox[
       RowBox[{"-", "d"}], 
       RowBox[{"1", "-", "c"}]], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"ProductLog", "[", 
         RowBox[{"0", ",", 
          RowBox[{
           RowBox[{"B", "[", 
            RowBox[{"c", ",", "r"}], "]"}], 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"1", "-", 
              FractionBox["x", "r"]}], ")"}], 
            FractionBox["1", "d"]]}]}], "]"}], "\[IndentingNewLine]", "-", 
        RowBox[{"ProductLog", "[", 
         RowBox[{"0", ",", 
          RowBox[{"B", "[", 
           RowBox[{"c", ",", "r"}], "]"}]}], "]"}]}], ")"}]}], "]"}], "/;", 
    RowBox[{"d", ">", "0"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9700423516135197`*^9, 3.970042374893256*^9}, 
   3.970042436221245*^9, {3.970042788783641*^9, 3.970042959695592*^9}, 
   3.970043195095908*^9, {3.970043494453588*^9, 3.970043507657864*^9}},
 CellLabel->
  "In[202]:=",ExpressionUUID->"21e6e1b0-e523-4d94-943d-99434beb4b00"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"B", "[", 
    RowBox[{"c_", ",", "r_"}], "]"}], ":=", 
   RowBox[{
    FractionBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", "c"}], ")"}], "r"}], 
     RowBox[{"1", "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "c"}], ")"}], "r"}]}]], 
    RowBox[{"Exp", "[", 
     FractionBox[
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "c"}], ")"}], "r"}], 
      RowBox[{"1", "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", "c"}], ")"}], "r"}]}]], "]"}]}]}], ";"}]], "Input",\

 CellChangeTimes->{{3.970042440402515*^9, 3.97004245326026*^9}, {
  3.970042498397084*^9, 3.970042553813789*^9}},
 CellLabel->
  "In[200]:=",ExpressionUUID->"b518005f-5b5a-4dfd-b53c-9ccda46913e0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Series", "[", 
