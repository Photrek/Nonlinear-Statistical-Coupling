 RowBox[{
  RowBox[{"Clear", "[", "gLogLog", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gLogLog", "[", "r_", "]"}], ":=", " ", 
   RowBox[{"r", " ", 
    RowBox[{"Log", "[", 
     RowBox[{"Log", "[", 
      RowBox[{"1", "/", "r"}], "]"}], "]"}]}]}], ";"}]}], "Input",
