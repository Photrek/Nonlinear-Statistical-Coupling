  3.973355450048258*^9}},ExpressionUUID->"deea46cd-2692-421f-967c-\
9200deb84bbd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Assuming", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Kappa]", ">", "0"}], "&&", 
     RowBox[{"d", ">", "0"}], "&&", 
     RowBox[{"\[Alpha]", ">", "0"}], "&&", 
     RowBox[{"\[Gamma]", ">", "0"}], "&&", 
     RowBox[{"\[Kappa]", "\[Element]", "Reals"}], "&&", 
     RowBox[{"d", "\[Element]", "Reals"}], "&&", 
     RowBox[{"\[Alpha]", "\[Element]", "Reals"}], "&&", 
     RowBox[{"\[Gamma]", "\[Element]", "Reals"}]}], ",", 
    RowBox[{"Limit", "[", 
     RowBox[{
      FractionBox[
       RowBox[{"G", "[", 
        RowBox[{
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"\[Lambda]", " ", "W"}], ")"}], "d"], " ", 
          RowBox[{"g", "[", 
           RowBox[{
            FractionBox["1", 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"\[Lambda]", " ", "W"}], ")"}], "d"]], ",", "\[Kappa]",
             ",", "\[Alpha]", ",", "d"}], "]"}]}], ",", "\[Gamma]"}], "]"}], 
       RowBox[{"G", "[", 
        RowBox[{
         RowBox[{
          SuperscriptBox["W", "d"], " ", 
          RowBox[{"g", "[", 
           RowBox[{
            FractionBox["1", 
             RowBox[{" ", 
              SuperscriptBox["W", "d"]}]], ",", "\[Kappa]", ",", "\[Alpha]", ",",
             "d"}], "]"}]}], ",", "\[Gamma]"}], "]"}]], ",", 
      RowBox[{"W", "->", "\[Infinity]"}]}], "]"}]}], "]"}], "//", 
  "FullSimplify"}]], "Input",
 CellChangeTimes->{{3.971979415457996*^9, 3.9719794830373697`*^9}, {
  3.971979535470867*^9, 3.9719796006554317`*^9}, {3.971980916437337*^9, 
  3.971980920095935*^9}, {3.973352888247356*^9, 3.97335296092362*^9}, {
  3.973355483869768*^9, 3.973355528885565*^9}, {3.973355595152486*^9, 
  3.973355638520499*^9}},
 CellLabel->
  "In[109]:=",ExpressionUUID->"c1f3841a-8d6c-4d3b-8e84-05f79d9f519b"],

Cell[BoxData[
 SuperscriptBox[
  RowBox[{"(", 
   SuperscriptBox[
    RowBox[{"(", 
     SuperscriptBox["\[Lambda]", 
      RowBox[{"-", "d"}]], ")"}], 
    RowBox[{"-", 
     FractionBox[
      RowBox[{"\[Alpha]", " ", "\[Kappa]"}], 
      RowBox[{"1", "+", 
       RowBox[{"d", " ", "\[Kappa]"}]}]]}]], ")"}], 
  FractionBox["1", "\[Gamma]"]]], "Output",
