Cell[TextData[{
 "Justification for scaling by ",
 Cell[BoxData[
  FormBox[
   FractionBox["\[Kappa]", 
    RowBox[{"1", "+", "a"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "991e5111-ad6d-4c94-9d8b-65274c4ee41e"],
 ".  The original compensation was ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["x", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", "a"}], ")"}], "\[Kappa]"}]], 
     SuperscriptBox["x", 
      RowBox[{
       RowBox[{"-", "a"}], " ", "\[Kappa]"}]]}], "=", 
    SuperscriptBox["x", "\[Kappa]"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "296b15a7-b35e-49a1-9a4e-4e9e481b972b"],
 "; so the modified compensation of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", "a"}], ")"}], " ", 
      FractionBox["\[Kappa]", 
       RowBox[{"1", "+", "a"}]]}]], "=", "x"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d2b1c158-1e37-45c2-be79-5b494964e7c2"],
 " has the same effect but it assures that multiplier of (1+a) exists for all \
\[Kappa] not just \[Kappa]=1."
}], "Text",
 CellChangeTimes->{{3.98416269676123*^9, 3.9841627710264053`*^9}, {
  3.9841628066438828`*^9, 
  3.9841630037354*^9}},ExpressionUUID->"e97dba99-3303-47d8-8abb-f83a4d2136e9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Limit", "[", 
  RowBox[{
   RowBox[{"Assuming", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Kappa]", ">", "0"}], "&&", 
      RowBox[{"x", ">", "0"}], "&&", 
      RowBox[{"a", ">", "0"}]}], ",", 
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "+", "a"}], ")"}], 
         RowBox[{"CoupledLogarithm", "[", 
          RowBox[{"x", ",", 
           RowBox[{"\[Kappa]", 
            RowBox[{"(", 
             RowBox[{"1", "+", "a"}], ")"}]}], ",", "0"}], "]"}]}], 
        RowBox[{"CoupledLogarithm", "[", 
         RowBox[{"x", ",", "\[Kappa]", ",", "0"}], "]"}]], 
       RowBox[{"(", 
        RowBox[{"1", "+", "a"}], ")"}], 
       RowBox[{"(", 
        SuperscriptBox["x", 
         RowBox[{
          RowBox[{"-", "a"}], " ", "\[Kappa]"}]], ")"}]}], "//", 
      "FullSimplify"}]}], "]"}], ",", 
   RowBox[{"x", "->", "\[Infinity]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.984156754190373*^9, 3.9841567566544447`*^9}, {
  3.984161832013515*^9, 3.984161871765984*^9}, {3.984161911430348*^9, 
  3.984161911764779*^9}},
 CellLabel->
  "In[178]:=",ExpressionUUID->"feeb4e35-32fa-4637-95af-5e5501e47222"],

