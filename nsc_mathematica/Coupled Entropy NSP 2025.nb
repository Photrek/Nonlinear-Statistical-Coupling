   RowBox[{"entDensity", "[", 
    RowBox[{"H_", ",", "\[Kappa]_"}], "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"CoupledExponential", "[", 
      RowBox[{"H", ",", "\[Kappa]"}], "]"}], 
     RowBox[{"-", "1"}]], "//", "FullSimplify"}]}], ";"}]], "Input",
