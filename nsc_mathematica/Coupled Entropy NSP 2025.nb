Cell[TextData[{
 "(2-q) Tsallis entropy of coupled exponential distribution\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", "x", ")"}], "=", 
    RowBox[{
     FractionBox["1", "\[Sigma]"], 
     SuperscriptBox[
      RowBox[{"(", 
