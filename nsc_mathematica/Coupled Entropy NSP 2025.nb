            FractionBox["1", "\[Kappa]"]}]], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "+", "\[Kappa]"}], ")"}], " ", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"1", "+", 
              RowBox[{"x0", " ", "\[Kappa]"}]}], ")"}], 
            FractionBox["1", "\[Kappa]"]], " ", 
           RowBox[{"(", 
            RowBox[{"x", "-", "x0"}], ")"}]}], "+", 
          RowBox[{
           FractionBox["1", "2"], " ", 
           RowBox[{"(", 
            RowBox[{"1", "+", "\[Kappa]"}], ")"}], " ", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"1", "+", 
              RowBox[{"x0", " ", "\[Kappa]"}]}], ")"}], 
            RowBox[{
             RowBox[{"-", "1"}], "+", 
             FractionBox["1", "\[Kappa]"]}]], " ", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"x", "-", "x0"}], ")"}], "2"]}], "-", 
          RowBox[{
           FractionBox["1", "6"], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "1"}], "+", "\[Kappa]"}], ")"}], " ", 
             RowBox[{"(", 
              RowBox[{"1", "+", "\[Kappa]"}], ")"}], " ", 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"1", "+", 
                RowBox[{"x0", " ", "\[Kappa]"}]}], ")"}], 
              RowBox[{
               RowBox[{"-", "2"}], "+", 
               FractionBox["1", "\[Kappa]"]}]]}], ")"}], " ", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"x", "-", "x0"}], ")"}], "3"]}], "+", 
          RowBox[{
           FractionBox["1", "24"], " ", 
           RowBox[{"(", 
            RowBox[{"1", "+", "\[Kappa]"}], ")"}], " ", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"1", "+", 
              RowBox[{"x0", " ", "\[Kappa]"}]}], ")"}], 
            RowBox[{
             RowBox[{"-", "3"}], "+", 
             FractionBox["1", "\[Kappa]"]}]], " ", 
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"3", " ", "\[Kappa]"}], "+", 
             RowBox[{"2", " ", 
              SuperscriptBox["\[Kappa]", "2"]}]}], ")"}], " ", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"x", "-", "x0"}], ")"}], "4"]}], "+", 
          InterpretationBox[
           SuperscriptBox[
            RowBox[{"O", "[", 
             RowBox[{"x", "-", "x0"}], "]"}], "5"],
           SeriesData[$CellContext`x, $CellContext`x0, {}, 0, 5, 1],
           Editable->False]}],
         SeriesData[$CellContext`x, $CellContext`x0, {(
            1 + $CellContext`x0 $CellContext`\[Kappa])^(
            1 + $CellContext`\[Kappa]^(-1)), (
            1 + $CellContext`\[Kappa]) (
             1 + $CellContext`x0 \
$CellContext`\[Kappa])^($CellContext`\[Kappa]^(-1)), 
           Rational[1, 2] (
            1 + $CellContext`\[Kappa]) (
             1 + $CellContext`x0 $CellContext`\[Kappa])^(-1 + $CellContext`\
\[Kappa]^(-1)), 
           Rational[-1, 6] (-1 + $CellContext`\[Kappa]) (
            1 + $CellContext`\[Kappa]) (
             1 + $CellContext`x0 $CellContext`\[Kappa])^(-2 + $CellContext`\
\[Kappa]^(-1)), 
           Rational[1, 24] (
            1 + $CellContext`\[Kappa]) (
             1 + $CellContext`x0 $CellContext`\[Kappa])^(-3 + $CellContext`\
\[Kappa]^(-1)) (1 - 3 $CellContext`\[Kappa] + 2 $CellContext`\[Kappa]^2)}, 0, 
          5, 1],
         Editable->False], 
        RowBox[{
         RowBox[{"x", "\[Element]", 
          TemplateBox[{},
           "Reals"]}], "&&", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"\[Kappa]", ">", "0"}], "&&", 
             RowBox[{
              RowBox[{"x0", " ", "\[Kappa]"}], ">", 
              RowBox[{"-", "1"}]}]}], ")"}], "||", 
           RowBox[{"(", 
