Cell["\<\
Define Stratonovich Process for Velocity with Multiplicative Noise and a \
Coupled Gaussian Limit Distribution\
\>", "Text",
 CellChangeTimes->{{3.9649134711373158`*^9, 3.9649134839256563`*^9}, {
  3.9650149649270277`*^9, 
  3.965014996114902*^9}},ExpressionUUID->"9492f114-6515-4d1f-93ae-\
b9cc262a7085"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MultVelProc", "=", 
  RowBox[{"StratonovichProcess", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"\[DifferentialD]", 
      RowBox[{"v", "[", "t", "]"}]}], "\[Equal]", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"v", "[", "t", "]"}]}], 
       RowBox[{"\[DifferentialD]", "t"}]}], "+", 
      RowBox[{
       SqrtBox[
        RowBox[{"2", "A"}]], 
       RowBox[{"\[DifferentialD]", 
        RowBox[{"WAdd", "[", "t", "]"}]}]}], "+", 
      RowBox[{
       SqrtBox["M"], " ", 
       RowBox[{"v", "[", "t", "]"}], 
       RowBox[{"\[DifferentialD]", 
        RowBox[{"WMult", "[", "t", "]"}]}]}]}]}], ",", 
    RowBox[{"v", "[", "t", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"v", ",", "1"}], "}"}], ",", "t", ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"WAdd", "\[Distributed]", 
       RowBox[{"WienerProcess", "[", "]"}]}], ",", 
      RowBox[{"WMult", "\[Distributed]", 
       RowBox[{"WienerProcess", "[", "]"}]}]}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.965018277450281*^9, 3.965018351407033*^9}, {
   3.965018421698782*^9, 3.9650184223602552`*^9}, {3.965025746554826*^9, 
   3.965025769222376*^9}, {3.965026003085506*^9, 3.965026005633847*^9}, {
   3.9650261072250347`*^9, 3.965026107332412*^9}, 3.965026549643856*^9, 
   3.986558812205531*^9, 3.986558915420909*^9, 3.9865590903171864`*^9},
 CellLabel->"In[1]:=",ExpressionUUID->"f68af9c5-86a7-4df5-a518-d30207f56d8e"],

Cell[BoxData[
 RowBox[{"StratonovichProcess", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"-", 
       RowBox[{"v", "[", "t", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         SqrtBox["2"], " ", 
         SqrtBox["A"]}], ",", 
        RowBox[{
         SqrtBox["M"], " ", 
         RowBox[{"v", "[", "t", "]"}]}]}], "}"}], "}"}], ",", 
     RowBox[{"v", "[", "t", "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", "v", "}"}], ",", 
     RowBox[{"{", "1", "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0"}], "}"}]}], "]"}]], "Output",
 CellChangeTimes->{
  3.9650183578500423`*^9, 3.965018428054879*^9, 3.9650227474263277`*^9, 
   3.9650256580886793`*^9, {3.96502574958593*^9, 3.9650257703764763`*^9}, 
   3.965026007203518*^9, 3.965026552738772*^9, {3.9865590643199167`*^9, 
   3.986559092179329*^9}, 3.986559134393889*^9, 3.99968107622519*^9},
 CellLabel->"Out[1]=",ExpressionUUID->"799dd66e-9612-494c-ba50-cc3c47674066"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"MultVelProc", "[", "\"\<KolmogorovForwardEquation\>\"", "]"}], "//",
   "TraditionalForm"}]], "Input",
 CellChangeTimes->{{3.965018471663868*^9, 3.965018473833436*^9}},
 CellLabel->
  "In[111]:=",ExpressionUUID->"e9856c9e-c8a7-4beb-ad3f-75cae275e317"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["\[FormalP]", 
     TagBox[
      RowBox[{"(", 
       RowBox[{"0", ",", "1"}], ")"}],
      Derivative],
     MultilineFunction->None], "(", 
    RowBox[{"v", ",", "t"}], ")"}], "\[LongEqual]", 
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], " ", 
     TagBox[
      FractionBox[
       RowBox[{
        SuperscriptBox["\[PartialD]", "2"], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"M", " ", 
             SuperscriptBox["v", "2"]}], "+", 
            RowBox[{"2", " ", "A"}]}], ")"}], " ", 
          RowBox[{"\[FormalP]", "(", 
           RowBox[{"v", ",", "t"}], ")"}]}], ")"}]}], 
       RowBox[{
        RowBox[{"\[PartialD]", "v"}], "\[ThinSpace]", 
        RowBox[{"\[PartialD]", "v"}]}],
       MultilineFunction->None],
      "InactiveDTraditional"]}], "-", 
    TagBox[
     TagBox[
      RowBox[{
       FractionBox["\[PartialD]", 
        RowBox[{"\[PartialD]", "v"}]], 
       RowBox[{"(", 
        RowBox[{
         FractionBox["1", "2"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"M", " ", "v"}], "-", 
           RowBox[{"2", " ", "v"}]}], ")"}], " ", 
         RowBox[{"\[FormalP]", "(", 
          RowBox[{"v", ",", "t"}], ")"}]}], ")"}]}],
      D],
     "InactiveDTraditional"]}]}], TraditionalForm]], "Output",
 CellChangeTimes->{
  3.965018476699297*^9, 3.965022751035221*^9, 3.965026015922262*^9, 
   3.965026129125733*^9, {3.986559067648291*^9, 3.986559096295795*^9}},
 CellLabel->
  "Out[111]//TraditionalForm=",ExpressionUUID->"c9420b92-97eb-49d5-9e4a-\
59b9df329248"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Limit", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"PDF", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"MultVelProc", "[", "t", "]"}], "/.", 
       RowBox[{"A", "->", 
        SuperscriptBox["\[Sigma]", "2"]}]}], ",", "v"}], "]"}], "//", 
    "FullSimplify"}], ",", 
   RowBox[{"t", "->", "Infinity"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.965018508816091*^9, 3.965018511018105*^9}, {
  3.986558829514205*^9, 3.9865588335049353`*^9}},
 CellLabel->
  "In[113]:=",ExpressionUUID->"9b9413df-fd53-4503-8264-7b07ebd5e151"],

Cell[BoxData[
 RowBox[{
  UnderscriptBox["\[Limit]", 
   RowBox[{"t", "\[Rule]", "\[Infinity]"}]], 
  RowBox[{"PDF", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"StratonovichProcess", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"-", 
           RowBox[{"v", "[", "t", "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             SqrtBox["2"], " ", 
             SqrtBox[
              SuperscriptBox["\[Sigma]", "2"]]}], ",", 
            RowBox[{
             SqrtBox["M"], " ", 
             RowBox[{"v", "[", "t", "]"}]}]}], "}"}], "}"}], ",", 
         RowBox[{"v", "[", "t", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", "v", "}"}], ",", 
         RowBox[{"{", "1", "}"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0"}], "}"}]}], "]"}], "[", "t", "]"}], ",", "v"}], 
   "]"}]}]], "Output",
 CellChangeTimes->{3.965018512257744*^9, 3.965022756181299*^9, 
  3.965026140986396*^9, 3.986559147957222*^9},
 CellLabel->
  "Out[113]=",ExpressionUUID->"5beb3046-ef66-465d-8d08-b3f30633958e"]
}, Open  ]],

