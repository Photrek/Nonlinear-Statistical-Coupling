Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["D", 
      RowBox[{"(", "\[Kappa]", ")"}]], 
     RowBox[{"f", "(", "x", ")"}]}], "\[Congruent]", 
    RowBox[{
     SubscriptBox["lim", 
      RowBox[{"y", "\[RightArrow]", "x"}]], 
     FractionBox[
      RowBox[{
       RowBox[{"f", "(", "y", ")"}], "-", 
       RowBox[{"f", "(", "x", ")"}]}], 
      RowBox[{"y", 
       SubscriptBox["\[CircleMinus]", "\[Kappa]"], "x"}]]}]}], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "+", "\[Kappa]x"}], ")"}], 
    RowBox[{"f", "'"}], 
    RowBox[{"(", "x", ")"}]}]}], TraditionalForm]],
 FormatType->
  TraditionalForm,ExpressionUUID->"ec734829-3a79-404d-8f62-07aeabd98e2c"]], \
"Text",
 CellChangeTimes->{{3.97653376981917*^9, 
  3.976533904768651*^9}},ExpressionUUID->"0c2e9a03-fc28-4473-ad24-\
c0046238a632"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["D", 
     RowBox[{"(", "\[Kappa]", ")"}]], 
    SuperscriptBox["\[Sigma]", 
     FractionBox["\[Kappa]", 
      RowBox[{"1", "+", "\[Kappa]"}]]]}], "=", 
   RowBox[{
    FractionBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", "\[Kappa]\[Sigma]"}], ")"}], "\[Kappa]"}], 
     RowBox[{"1", "+", "\[Kappa]"}]], 
    SuperscriptBox["\[Sigma]", 
     RowBox[{"-", 
      FractionBox["1", 
       RowBox[{"1", "+", "\[Kappa]"}]]}]]}]}], TraditionalForm]],
