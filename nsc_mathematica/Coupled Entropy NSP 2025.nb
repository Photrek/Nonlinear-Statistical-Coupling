Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SuperscriptBox["D", 
      RowBox[{"(", "\[Kappa]", ")"}]], 
     RowBox[{"f", "(", "x", ")"}]}], "\[Congruent]", 
    RowBox[{
     SubscriptBox["lim", 
      RowBox[{"y", "\[RightArrow]", "x"}]], 
     FractionBox[
      RowBox[{
       RowBox[{"f", "(", "y", ")"}], 
       SubscriptBox["\[CircleMinus]", "\[Kappa]"], 
