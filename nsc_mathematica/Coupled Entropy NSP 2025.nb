}, Open  ]],

Cell[TextData[{
 "Thus the scaling of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "+", "a"}], ")"}], "d"], TraditionalForm]],ExpressionUUID->
  "ca473b30-e986-415a-ad91-bea5a7b747ce"],
