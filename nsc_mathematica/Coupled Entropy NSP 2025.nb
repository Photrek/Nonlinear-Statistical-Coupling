Cell[CellGroupData[{

Cell["Generalized Weibull Distribution", "Subsection",
 CellChangeTimes->{{3.962179932274612*^9, 3.962179940348791*^9}, {
  3.962181402437662*^9, 
  3.9621814029242268`*^9}},ExpressionUUID->"0724c60a-7b31-4a85-852c-\
2cedc69210b5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GWDSF", "[", 
    RowBox[{"\[Sigma]_", ",", "\[Kappa]_", ",", "\[Alpha]_", ",", "x_"}], 
    "]"}], ":=", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "+", 
      FractionBox[
       RowBox[{"\[Kappa]", " ", 
        SuperscriptBox["x", "\[Alpha]"]}], 
       SuperscriptBox["\[Sigma]", "\[Alpha]"]]}], ")"}], 
    RowBox[{"-", 
     FractionBox["1", 
      RowBox[{"\[Alpha]", " ", "\[Kappa]"}]]}]]}], ";"}]], "Input",
 CellChangeTimes->{{3.962180075677472*^9, 3.962180229242771*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"90557000-c630-48b5-9c18-e07977555da1"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GWDPDF", "[", 
    RowBox[{"\[Sigma]_", ",", "\[Kappa]_", ",", "\[Alpha]_", ",", "x_"}], 
    "]"}], ":=", 
   RowBox[{
    FractionBox[
     SuperscriptBox["x", 
      RowBox[{"\[Alpha]", "-", "1"}]], 
     SuperscriptBox["\[Sigma]", "\[Alpha]"]], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "+", 
       FractionBox[
        RowBox[{"\[Kappa]", " ", 
         SuperscriptBox["x", "\[Alpha]"]}], 
        SuperscriptBox["\[Sigma]", "\[Alpha]"]]}], ")"}], 
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", 
        RowBox[{"\[Alpha]", " ", "\[Kappa]"}]]}], "-", "1"}]]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.96218023740368*^9, 3.9621802402028713`*^9}, {
  3.962180323427062*^9, 3.962180399758176*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"a69ba429-1fca-4834-8088-0ba0e99233f9"],

