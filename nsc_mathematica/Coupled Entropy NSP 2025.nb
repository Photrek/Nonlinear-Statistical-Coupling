Cell[BoxData[
 RowBox[{
  RowBox[{"Assuming", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"0", "<", "\[Kappa]", "<", "\[Infinity]"}], "&&", 
     RowBox[{"0", "<", "\[Alpha]", "<", "\[Infinity]"}], "&&", 
     RowBox[{"0", "<", "\[Sigma]", "<", "\[Infinity]"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     FractionBox[
      RowBox[{"Gamma", "[", 
       RowBox[{"1", "+", 
        FractionBox["1", "\[Alpha]"], "+", 
        FractionBox["1", "\[Kappa]"]}], "]"}], 
      RowBox[{"2", " ", 
       SuperscriptBox[
        RowBox[{"(", 
         FractionBox["\[Alpha]", "\[Kappa]"], ")"}], 
        FractionBox["1", "\[Alpha]"]], " ", "\[Sigma]", " ", 
       RowBox[{"Gamma", "[", 
        RowBox[{"1", "+", 
         FractionBox["1", "\[Alpha]"]}], "]"}], " ", 
       RowBox[{"Gamma", "[", 
        RowBox[{"1", "+", 
         FractionBox["1", "\[Kappa]"]}], "]"}]}]], 
     RowBox[{
      SubsuperscriptBox["\[Integral]", 
       RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
      RowBox[{
       SuperscriptBox["x", "\[Alpha]"], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{
           FractionBox[
            RowBox[{"\[Kappa]", " "}], "\[Alpha]"], 
           SuperscriptBox[
            RowBox[{"Abs", "[", 
             FractionBox["x", "\[Sigma]"], "]"}], "\[Alpha]"]}]}], ")"}], 
        RowBox[{
         RowBox[{"-", " ", 
          RowBox[{"(", 
           RowBox[{
            FractionBox["1", "\[Alpha]"], "+", 
            FractionBox["1", "\[Kappa]"]}], ")"}]}], 
         RowBox[{"(", 
          RowBox[{"1", "+", " ", 
           FractionBox[
            RowBox[{"\[Alpha]", " ", "\[Kappa]"}], 
            RowBox[{"\[Alpha]", "+", "\[Kappa]"}]]}], ")"}]}]], 
       RowBox[{"\[DifferentialD]", "x"}]}]}]}]}], "]"}], "//", 
  "FullSimplify"}]], "Input",
 CellChangeTimes->{{3.9857435951264963`*^9, 3.9857436427358007`*^9}, {
