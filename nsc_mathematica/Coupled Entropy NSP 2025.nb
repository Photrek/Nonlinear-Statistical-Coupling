Cell[BoxData[
 RowBox[{
  RowBox[{"Series", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      FractionBox[
       RowBox[{"1", "+", "\[Kappa]"}], 
       RowBox[{"2", "\[Kappa]"}]], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"PolyGamma", "[", 
         FractionBox[
          RowBox[{"1", "+", "\[Kappa]"}], 
          RowBox[{"2", "\[Kappa]"}]], "]"}], "-", 
        RowBox[{"PolyGamma", "[", 
         FractionBox["1", 
          RowBox[{"2", "\[Kappa]"}]], "]"}]}], ")"}]}], "+", 
     "\[IndentingNewLine]", 
     RowBox[{"Log", "[", 
      RowBox[{
       FractionBox["1", 
        SqrtBox["\[Kappa]"]], 
       RowBox[{"Beta", "[", 
        RowBox[{
         FractionBox["1", 
          RowBox[{"2", "\[Kappa]"}]], ",", 
         FractionBox["1", "2"]}], "]"}]}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"\[Kappa]", ",", "0", ",", "3"}], "}"}]}], "]"}], "//", 
  "FullSimplify"}]], "Input",
