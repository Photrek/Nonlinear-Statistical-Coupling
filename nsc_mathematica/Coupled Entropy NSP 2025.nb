Cell[CellGroupData[{

Cell["Score Function Plots", "Subsection",
 CellChangeTimes->{{3.961782007863496*^9, 
  3.961782012573473*^9}},ExpressionUUID->"24316422-a049-4882-a6ee-\
8a290b39000e"],

Cell[TextData[{
 "The score function of the GPD is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SuperscriptBox["\[Sigma]", 
     RowBox[{"-", "1"}]]}], TraditionalForm]],ExpressionUUID->
  "114648ab-0f7c-40e1-9cc5-9be6e174108d"],
 ", which is a powerful description of the scales unique properties.\nThe \
score function is computed from the derivative of the log of the pdf."
}], "Text",
 CellChangeTimes->{{3.96178201739402*^9, 
  3.961782114077993*^9}},ExpressionUUID->"b5282265-7ffe-4945-99b0-\
8ffd620d8b84"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"NegDerGPD", "[", 
    RowBox[{"\[Sigma]_", ",", "\[Kappa]_", ",", "x_"}], "]"}], ":=", 
   FractionBox[
    RowBox[{"1", "+", "\[Kappa]"}], 
    RowBox[{
     RowBox[{"x", " ", "\[Kappa]"}], "+", "\[Sigma]"}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"NegDerGPDq", "[", 
    RowBox[{"\[Beta]_", ",", "q_", ",", "x_"}], "]"}], ":=", 
   FractionBox["\[Beta]", 
    RowBox[{"1", "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "q"}], ")"}], " ", "x", " ", 
      "\[Beta]"}]}]]}], ";"}]}], "Input",
 CellChangeTimes->{{3.96178214503312*^9, 3.961782208338665*^9}, {
  3.96178226085704*^9, 3.961782268348*^9}, {3.961782300357747*^9, 
  3.9617823802380447`*^9}, {3.9617825962780247`*^9, 3.961782617302993*^9}, {
  3.96178281305678*^9, 3.961782814364201*^9}, {3.961784065925357*^9, 
  3.9617840811582823`*^9}, {3.961785578033993*^9, 3.961785615239151*^9}},
 CellLabel->"In[97]:=",ExpressionUUID->"b8e3572d-d81f-4d08-b02e-c1566736c83a"],

Cell[BoxData[
 RowBox[{"Clear", "[", "NegDerGPD", "]"}]], "Input",
 CellChangeTimes->{{3.9617840886767197`*^9, 3.961784108115526*^9}},
 CellLabel->
  "In[220]:=",ExpressionUUID->"7ce7a37e-8110-4c11-a839-48e043613d58"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Assuming", "[", 
   RowBox[{
    RowBox[{"0", "<", "\[Kappa]", "<", "\[Infinity]"}], ",", 
    RowBox[{"-", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"Log", "[", 
        RowBox[{
         FractionBox["1", "\[Sigma]"], 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"1", "+", 
            FractionBox[
             RowBox[{"\[Kappa]", " ", "x"}], "\[Sigma]"]}], ")"}], 
          RowBox[{"-", 
           FractionBox[
            RowBox[{"1", "+", "\[Kappa]"}], "\[Kappa]"]}]]}], "]"}], ",", 
       "x"}], "]"}]}]}], "]"}], "//", "FullSimplify"}]], "Input",
 CellChangeTimes->{{3.96178250098687*^9, 3.9617825662319117`*^9}},
 CellLabel->
  "In[206]:=",ExpressionUUID->"389ff22c-31b9-45aa-83fe-ca71463a39dd"],

Cell[BoxData[
 FractionBox[
  RowBox[{"1", "+", "\[Kappa]"}], 
  RowBox[{
   RowBox[{"x", " ", "\[Kappa]"}], "+", "\[Sigma]"}]]], "Output",
 CellChangeTimes->{3.961782567515094*^9},
 CellLabel->
  "Out[206]=",ExpressionUUID->"93a7fb04-3b5d-4a96-8709-49223de30530"]
}, Closed]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   FractionBox[
    RowBox[{"1", "+", "\[Kappa]"}], 
    RowBox[{
     RowBox[{"x", " ", "\[Kappa]"}], "+", "\[Sigma]"}]], "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Kappa]", "->", 
      FractionBox[
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{"1", "-", "q"}], ")"}]}], 
       RowBox[{"2", "-", "q"}]]}], ",", 
     RowBox[{"\[Sigma]", "->", 
      FractionBox["1", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"2", "-", "q"}], ")"}], "\[Beta]"}]]}]}], "}"}]}], "//", 
  "FullSimplify"}]], "Input",
 CellChangeTimes->{{3.961785386318248*^9, 3.961785460427334*^9}, {
  3.961785518366467*^9, 3.961785542962366*^9}},
 CellLabel->
  "In[243]:=",ExpressionUUID->"d795cb5a-5183-4423-be04-fd8d16ed7c45"],

Cell[BoxData[
 FractionBox["\[Beta]", 
  RowBox[{"1", "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", "q"}], ")"}], " ", "x", " ", 
    "\[Beta]"}]}]]], "Output",
 CellChangeTimes->{3.9617855437312737`*^9},
 CellLabel->
  "Out[243]=",ExpressionUUID->"c2b74f96-5f61-4003-be1c-a5fdb8f07746"]
}, Closed]],

Cell[TextData[{
 "Plot -\[Beta] Score versus ",
 Cell[BoxData[
  FormBox[
   FractionBox["x", "\[Beta]"], TraditionalForm]],ExpressionUUID->
  "65ed005d-be9b-4635-ad2b-110f28dc28a6"]
}], "Text",
 CellChangeTimes->{{3.961782707530892*^9, 3.961782717490518*^9}, {
  3.961782853721477*^9, 3.9617828761305532`*^9}, {3.961782906789339*^9, 
  3.9617829387065697`*^9}},ExpressionUUID->"54007c5b-3a02-463e-98f4-\
d5c4c429d2b8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"MapThread", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"scaleShapeToBeta", "[", 
         RowBox[{"#1", ",", "#2", ",", "1"}], "]"}], "\[IndentingNewLine]", 
        RowBox[{"NegDerGPD", "[", 
         RowBox[{"#1", ",", "#2", ",", 
          RowBox[{
           RowBox[{"scaleShapeToBeta", "[", 
            RowBox[{"#1", ",", "#2", ",", "1"}], "]"}], "x"}]}], "]"}]}], 
       "&"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "0.75", ",", "0.75", ",", "0.75", ",", "1.25", ",", "1.25", ",", 
          "1.25"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
         "0.25", ",", "0.5", ",", "1", ",", "0.25", ",", "0.5", ",", "1"}], 
         "}"}]}], "}"}]}], "]"}], "//", "Evaluate"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0.0001", ",", "10"}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"Background", "->", "LightGreen"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "8"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "4"}], "}"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
   
   RowBox[{"PlotStyle", "->", 
    RowBox[{"{", 
     RowBox[{"Blue", ",", "Green", ",", " ", "Red", ",", 
      RowBox[{"{", 
       RowBox[{"Blue", ",", "Dashed"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"Green", ",", "Dashed"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"Red", ",", "Dashed"}], "}"}]}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
