Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"g", ",", "G", ",", "\[Kappa]"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", 
    RowBox[{"r_", ",", "\[Kappa]_", ",", "\[Alpha]_", ",", "d_"}], "]"}], ":=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{" ", "\[Kappa]"}]], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["r", 
       RowBox[{"1", "-", 
        FractionBox[
         RowBox[{" ", "\[Kappa]"}], 
         RowBox[{"1", "+", 
          RowBox[{"d", " ", 
           RowBox[{"\[Kappa]", "/", "\[Alpha]"}]}]}]]}]], "-", "r"}], 
     ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"G", "[", 
    RowBox[{"u_", ",", "\[Alpha]_"}], "]"}], ":=", 
   SuperscriptBox["u", 
    FractionBox["1", "\[Alpha]"]]}], ";"}]}], "Input",
