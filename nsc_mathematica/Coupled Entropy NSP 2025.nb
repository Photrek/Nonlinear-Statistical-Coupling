          RowBox[{
           FractionBox["1", "2"], " ", 
           SuperscriptBox["\[ExponentialE]", "x0"], " ", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"x", "-", "x0"}], ")"}], "2"]}], "+", 
          RowBox[{
           FractionBox["1", "6"], " ", 
           SuperscriptBox["\[ExponentialE]", "x0"], " ", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"x", "-", "x0"}], ")"}], "3"]}], "+", 
          RowBox[{
           FractionBox["1", "24"], " ", 
