Cell[CellGroupData[{

Cell["Score of Coupled Stretched Exponential Distribution", "Subsection",
 CellChangeTimes->{{3.965800343349247*^9, 
  3.9658003525710917`*^9}},ExpressionUUID->"d69ed03c-d955-43cc-9693-\
ba5e73d1fe71"],

Cell["\<\
Computing - d Log[f(x)]/dx where f(x) is the Coupled Stretched Exponential \
Distribution.  The normalization, Z, can be ignored since the expression is \
equivalent to -d f\[CloseCurlyQuote](x)/(f(x) dx) and constants cancel.\
\>", "Text",
 CellChangeTimes->{{3.9658003857727213`*^9, 
  3.965800507164507*^9}},ExpressionUUID->"6ac29f2f-2170-46e5-8826-\
82afab472186"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   SubscriptBox["\[PartialD]", "x"], " ", 
   RowBox[{"Log", "[", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"\[Kappa]", " ", 
        SuperscriptBox[
         RowBox[{"(", 
          FractionBox["x", "\[Sigma]"], ")"}], "\[Alpha]"]}]}], ")"}], 
     RowBox[{
      RowBox[{"-", " ", 
       FractionBox["1", "\[Alpha]"]}], 
      RowBox[{"(", 
       RowBox[{
        FractionBox["1", "\[Kappa]"], "+", "1"}], ")"}]}]], "]"}]}], "//", 
  "FullSimplify"}]], "Input",
 CellChangeTimes->{{3.965800543861388*^9, 3.965800705866417*^9}},
 CellLabel->"In[96]:=",ExpressionUUID->"fd2b2bad-fcbc-49ab-ad4b-f98cc738c338"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{
    SuperscriptBox["x", 
     RowBox[{
      RowBox[{"-", "1"}], "+", "\[Alpha]"}]], " ", 
    RowBox[{"(", 
     RowBox[{"1", "+", "\[Kappa]"}], ")"}]}], 
   RowBox[{
    RowBox[{
     SuperscriptBox["x", "\[Alpha]"], " ", "\[Kappa]"}], "+", 
    SuperscriptBox["\[Sigma]", "\[Alpha]"]}]]}]], "Output",
 CellChangeTimes->{{3.965800548782724*^9, 3.965800558654599*^9}, {
  3.9658006804861917`*^9, 3.965800708620002*^9}},
 CellLabel->"Out[96]=",ExpressionUUID->"0f3a180e-5806-449f-a419-8902a83fefac"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   FractionBox[
    RowBox[{
     SuperscriptBox["x", 
      RowBox[{
       RowBox[{"-", "1"}], "+", "\[Alpha]"}]], " ", 
     RowBox[{"(", 
      RowBox[{"1", "+", "\[Kappa]"}], ")"}]}], 
    RowBox[{
