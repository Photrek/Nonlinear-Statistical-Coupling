Cell[TextData[{
 "For Coupled Entropy, consider that for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["p", "i"], "=", 
    FractionBox["1", "W"]}], TraditionalForm]],ExpressionUUID->
  "2c76855b-b217-45d7-a15e-94cd6a60b294"],
 ", the independent equals distribution also equals ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "i"], TraditionalForm]],ExpressionUUID->
  "665a22a4-695c-4c21-a59a-c0713153ed95"],
 ". Then g(x) = x ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["ln", 
     RowBox[{" ", "\[Kappa]"}]], 
    SuperscriptBox["x", 
     RowBox[{"-", 
      FractionBox["1", 
       RowBox[{"1", "+", 
        RowBox[{"d", " ", 
         RowBox[{"\[Kappa]", "/", "\[Alpha]"}]}]}]]}]]}], TraditionalForm]],
  ExpressionUUID->"4f30203c-2408-4d89-8f5d-cf1517713206"],
 "=",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["x", 
     RowBox[{" ", "\[Kappa]", " "}]], 
    SuperscriptBox["x", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{" ", "\[Kappa]"}], 
       RowBox[{"1", "+", 
        RowBox[{"d", " ", 
         RowBox[{"\[Kappa]", "/", "\[Alpha]"}]}]}]]}]]}], TraditionalForm]],
  ExpressionUUID->"024cef6d-f78d-4a8a-8ce2-2f4c89274973"],
 "+O(x) = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", 
     RowBox[{" ", "\[Kappa]", " "}]], 
    SuperscriptBox["x", 
     RowBox[{"1", "-", 
      FractionBox[
       RowBox[{" ", "\[Kappa]"}], 
       RowBox[{"1", "+", 
        RowBox[{"d", " ", 
         RowBox[{"\[Kappa]", "/", "\[Alpha]"}]}]}]]}]]}], TraditionalForm]],
  ExpressionUUID->"ee214af0-6deb-42bd-a241-f9274dc3299e"],
 "+O(x) = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", 
     RowBox[{"\[Alpha]", " ", "\[Kappa]", " "}]], 
    SuperscriptBox["x", 
     RowBox[{"2", "-", "q"}]]}], TraditionalForm]],ExpressionUUID->
  "8ca44f44-56e9-47ec-a53d-d5a5daea0205"],
 "+O(x)\nand G(u) = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["u", 
    FractionBox["d", "\[Alpha]"]], TraditionalForm]],ExpressionUUID->
  "310bac38-bf3d-4102-93d5-ec7666df26e5"],
 "."
}], "Text",
 CellChangeTimes->{{3.971978602978764*^9, 3.9719787641805487`*^9}, {
