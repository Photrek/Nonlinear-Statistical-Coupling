Cell[CellGroupData[{

Cell["Boundary Condition for Concave Entropy", "Subsubsection",
 CellChangeTimes->{{3.983619447476275*^9, 
  3.983619458454818*^9}},ExpressionUUID->"6c7e514f-fb48-4ec0-9c1d-\
80e7ce112e7e"],

Cell[TextData[{
 "q > 0 is the boundary for concave entropy\nTherefore, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"\[Alpha]", " ", "\[Kappa]"}], 
      RowBox[{"1", "+", 
       RowBox[{"d", " ", "\[Kappa]"}]}]], ">", 
     RowBox[{"-", "1"}]}], ";", 
    RowBox[{
     RowBox[{"\[Alpha]", " ", "\[Kappa]"}], ">", 
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"d", " ", "\[Kappa]"}]}], ")"}]}]}], ";", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"\[Alpha]", "+", "d"}], ")"}], "\[Kappa]"}], ">", 
     RowBox[{"-", "1"}]}], ";", 
    RowBox[{"\[Kappa]", ">", 
     RowBox[{"-", 
      FractionBox["1", 
       RowBox[{"\[Alpha]", "+", "d"}]], " "}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0477083c-5b7d-453c-ab72-fa2acc563ffe"]
}], "Text",
 CellChangeTimes->{{3.983619465988949*^9, 3.983619557057941*^9}, {
  3.98361959821697*^9, 
  3.983619638325279*^9}},ExpressionUUID->"21e245d8-5230-4b0a-ab10-\
4395f62e5677"]
}, Open  ]]
}, Open  ]]
}, Closed]],

