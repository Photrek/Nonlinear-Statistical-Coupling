    FractionBox[
     RowBox[{"1", "+", 
      RowBox[{"d", " ", "\[Kappa]Old"}]}], 
     RowBox[{"\[Alpha]", " ", "\[Kappa]Old"}]]}], ",", "\[Kappa]Old"}], 
