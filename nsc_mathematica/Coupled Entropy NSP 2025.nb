Cell[BoxData[
 FractionBox[
  RowBox[{"\[Sigma]", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "1"}], "+", 
     FractionBox[
      RowBox[{"1", "+", "\[Kappa]", "+", 
       RowBox[{"\[Kappa]", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"\[Sigma]", "\[GreaterEqual]", "0"}], ",", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             FractionBox["\[Kappa]", 
              RowBox[{"1", "+", "\[Kappa]"}]], "\[NotEqual]", "0"}], ",", 
            FractionBox[
             RowBox[{
              SuperscriptBox["\[Sigma]", 
               FractionBox["\[Kappa]", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", "+", "\[Kappa]"}], ")"}], " ", 
                 RowBox[{"(", 
                  RowBox[{"1", "+", 
                   FractionBox[
                    RowBox[{"0", " ", "\[Kappa]"}], 
                    RowBox[{"1", "+", "\[Kappa]"}]]}], ")"}]}]]], "-", "1"}], 
             
             FractionBox["\[Kappa]", 
              RowBox[{"1", "+", "\[Kappa]"}]]], ",", 
            RowBox[{"Log", "[", "\[Sigma]", "]"}]}], "]"}], ",", 
          "Undefined"}], "]"}]}]}], 
      RowBox[{"1", "+", 
       RowBox[{"\[Kappa]", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           SuperscriptBox["\[Sigma]", 
            FractionBox["1", 
