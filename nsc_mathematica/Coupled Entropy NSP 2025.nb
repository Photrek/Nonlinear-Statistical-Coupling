        SuperscriptBox["\[Sigma]", "\[Alpha]"]]}], ")"}], 
     RowBox[{"-", "1"}]]}], "/.", 
   RowBox[{"x", "->", "\[Sigma]"}]}], "//", "FullSimplify"}]], "Input",
