Cell[TextData[{
 "What if the scaling of states is assumed to be dependent on the dimensions \
by ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["W", "d"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7f47719d-d6d7-4b75-83d8-8e23724a11a6"],
 "?"
}], "Text",
