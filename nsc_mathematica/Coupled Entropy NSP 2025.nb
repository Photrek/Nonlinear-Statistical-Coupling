Cell["\<\
Consider solving for x, such that the score is equal to its inverse.\
\>", "Text",
 CellChangeTimes->{{3.965801075908305*^9, 
  3.965801091894411*^9}},ExpressionUUID->"8202f88a-5e60-4375-9a57-\
f74d9a1aa835"],

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       FractionBox[
        RowBox[{
         SuperscriptBox["x", 
          RowBox[{"\[Alpha]", "-", "1"}]], 
         RowBox[{"(", 
          RowBox[{"1", "+", "\[Kappa]"}], ")"}]}], 
        SuperscriptBox["\[Sigma]", "\[Alpha]"]], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", "\[Alpha]"}], ")"}], 
        SuperscriptBox["x", 
         RowBox[{"-", "1"}]]}]}], ")"}], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "+", 
        FractionBox[
         RowBox[{"\[Kappa]", " ", 
          SuperscriptBox["x", "\[Alpha]"]}], 
         SuperscriptBox["\[Sigma]", "\[Alpha]"]]}], ")"}], 
      RowBox[{"-", "1"}]]}], "==", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         FractionBox[
          RowBox[{
           SuperscriptBox["x", 
            RowBox[{"\[Alpha]", "-", "1"}]], 
           RowBox[{"(", 
            RowBox[{"1", "+", "\[Kappa]"}], ")"}]}], 
          SuperscriptBox["\[Sigma]", "\[Alpha]"]], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", "\[Alpha]"}], ")"}], 
          SuperscriptBox["x", 
           RowBox[{"-", "1"}]]}]}], ")"}], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "+", 
          FractionBox[
           RowBox[{"\[Kappa]", " ", 
            SuperscriptBox["x", "\[Alpha]"]}], 
           SuperscriptBox["\[Sigma]", "\[Alpha]"]]}], ")"}], 
        RowBox[{"-", "1"}]]}], ")"}], 
     RowBox[{"-", "1"}]]}], ",", "x"}], "]"}]], "Input",
 CellChangeTimes->{{3.965801096127489*^9, 3.9658011321289177`*^9}},
 CellLabel->"In[99]:=",ExpressionUUID->"a174e139-2854-4882-8c10-5c8f633c6bbc"],

