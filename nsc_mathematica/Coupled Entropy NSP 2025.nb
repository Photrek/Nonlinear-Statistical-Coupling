Cell[CellGroupData[{

Cell["\<\
Redefined Coupled Weibull with \[Sigma] equal to the \
\[OpenCurlyDoubleQuote]Informational Scale\[CloseCurlyDoubleQuote]\
\>", "Subsection",
 CellChangeTimes->{{3.96624295087217*^9, 
  3.96624300379842*^9}},ExpressionUUID->"2d29c86c-9c43-4fee-9b5d-\
ca3304a17492"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GWDSF", "[", 
    RowBox[{"\[Sigma]_", ",", "\[Kappa]_", ",", "\[Alpha]_", ",", "x_"}], 
    "]"}], ":=", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{"\[Alpha]", " ", "\[Kappa]", 
       FractionBox[
        SuperscriptBox["x", "\[Alpha]"], 
        SuperscriptBox["\[Sigma]", "\[Alpha]"]]}]}], ")"}], 
    RowBox[{"-", 
     FractionBox["1", 
      RowBox[{"\[Alpha]", " ", "\[Kappa]"}]]}]]}], ";"}]], "Input",
 CellChangeTimes->{{3.962180075677472*^9, 3.962180229242771*^9}, {
   3.966243011792738*^9, 3.966243026199903*^9}, 3.966243331144959*^9},
 CellLabel->"In[37]:=",ExpressionUUID->"695af356-8ea1-4d62-8be4-e1459b948c93"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GWDPDF", "[", 
    RowBox[{"\[Sigma]_", ",", "\[Kappa]_", ",", "\[Alpha]_", ",", "x_"}], 
    "]"}], ":=", 
   RowBox[{
    FractionBox[
     RowBox[{"\[Alpha]", " ", 
      SuperscriptBox["x", 
       RowBox[{"\[Alpha]", "-", "1"}]]}], 
     SuperscriptBox["\[Sigma]", "\[Alpha]"]], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"\[Alpha]", " ", "\[Kappa]", 
        FractionBox[
         SuperscriptBox["x", "\[Alpha]"], 
         SuperscriptBox["\[Sigma]", "\[Alpha]"]]}]}], ")"}], 
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", 
        RowBox[{"\[Alpha]", " ", "\[Kappa]"}]]}], "-", "1"}]]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.96218023740368*^9, 3.9621802402028713`*^9}, {
   3.962180323427062*^9, 3.962180399758176*^9}, {3.966243037729137*^9, 
   3.9662430764564743`*^9}, 3.966243335131124*^9, {3.966243713807077*^9, 
   3.966243753940921*^9}, {3.966243814373167*^9, 3.9662438150318336`*^9}},
 CellLabel->"In[38]:=",ExpressionUUID->"7e88f7ec-d9b8-45fb-a6c0-b047704f65e7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"-", "x"}], " ", 
   FractionBox[
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"GWDPDF", "[", 
       RowBox[{"\[Sigma]", ",", "\[Kappa]", ",", "\[Alpha]", ",", "x"}], 
       "]"}], ",", "x"}], "]"}], 
    RowBox[{"GWDPDF", "[", 
     RowBox[{"\[Sigma]", ",", "\[Kappa]", ",", "\[Alpha]", ",", "x"}], 
     "]"}]]}], "//", "FullSimplify"}]], "Input",
 CellChangeTimes->{{3.966243152058508*^9, 3.966243231851946*^9}, {
  3.9662448438311567`*^9, 3.966244848035104*^9}},
 CellLabel->"In[39]:=",ExpressionUUID->"740a3434-e3e7-473b-9135-660cef12a757"],

Cell[BoxData[
 RowBox[{"1", "+", 
  FractionBox[
   RowBox[{"\[Alpha]", " ", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["x", "\[Alpha]"], "-", 
      SuperscriptBox["\[Sigma]", "\[Alpha]"]}], ")"}]}], 
   RowBox[{
    RowBox[{
     SuperscriptBox["x", "\[Alpha]"], " ", "\[Alpha]", " ", "\[Kappa]"}], "+", 
