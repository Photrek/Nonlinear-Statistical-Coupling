Cell[TextData[{
 "This is equivalent to modifying the definition of the Coupled Weibull \
Distribution to be\[LineSeparator]",
 Cell[BoxData[
  RowBox[{
   FractionBox[
    SuperscriptBox["x", 
     RowBox[{"\[Alpha]", "-", "1"}]], 
    SuperscriptBox["\[Sigma]", "\[Alpha]"]], 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{"\[Alpha]\[Kappa]", 
       FractionBox[
        SuperscriptBox["x", "\[Alpha]"], 
        SuperscriptBox["\[Alpha]\[Sigma]", "\[Alpha]"]]}]}], ")"}], 
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", 
       RowBox[{"\[Alpha]", " ", "\[Kappa]"}]]}], "-", "1"}]]}]],
  CellChangeTimes->{{3.96218023740368*^9, 3.9621802402028713`*^9}, {
   3.962180323427062*^9, 3.962180399758176*^9}},ExpressionUUID->
  "d18065bb-c958-4c86-8212-defc2325dbaa"]
}], "Text",
