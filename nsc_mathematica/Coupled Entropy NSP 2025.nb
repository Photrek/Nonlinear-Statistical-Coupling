}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Assuming", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"0", "<", "\[Kappa]", "<", "\[Infinity]"}], "&&", 
     RowBox[{"0", "<", "\[Alpha]", "<", "\[Infinity]"}], "&&", 
     RowBox[{"0", "<", "\[Sigma]", "<", "\[Infinity]"}], "&&", 
