          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"\[Kappa]", "\[NotEqual]", "0"}], ",", 
            FractionBox[
             RowBox[{
              SuperscriptBox[
               RowBox[{"(", 
                SuperscriptBox["\[Sigma]", 
                 FractionBox["1", 
                  RowBox[{"1", "+", "\[Kappa]"}]]], ")"}], 
               FractionBox["\[Kappa]", 
                RowBox[{"1", "+", 
                 RowBox[{"0", " ", "\[Kappa]"}]}]]], "-", "1"}], "\[Kappa]"], 
            ",", 
            RowBox[{"Log", "[", 
             SuperscriptBox["\[Sigma]", 
              FractionBox["1", 
               RowBox[{"1", "+", "\[Kappa]"}]]], "]"}]}], "]"}], ",", 
          "Undefined"}], "]"}]}]}]]}], ")"}]}], "\[Kappa]"]], "Output",
