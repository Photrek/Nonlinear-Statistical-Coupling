       RowBox[{"d", " ", "\[Kappa]"}]}]],
     TraditionalForm]]], "=", 
  SuperscriptBox["W", 
   RowBox[{"a", 
    FormBox[
     FractionBox[
      RowBox[{"\[Alpha]", " ", "\[Kappa]"}], 
      RowBox[{"1", "+", 
       RowBox[{"d", " ", "\[Kappa]"}]}]],
     TraditionalForm]}]]}]], "Text",
