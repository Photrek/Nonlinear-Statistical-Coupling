Cell[TextData[{
 "Generalized Fisher metric for the coupled exponential distribution\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["ln", "\[Kappa]"], 
     SuperscriptBox["f", 
      RowBox[{"-", 
       FractionBox["1", 
        RowBox[{"1", "+", "\[Kappa]"}]]}]]}], "=", 
    RowBox[{
     RowBox[{
      FractionBox["x", "\[Sigma]"], "+", 
      RowBox[{
       SubscriptBox["ln", 
        FractionBox["\[Kappa]", 
         RowBox[{"1", "+", "\[Kappa]"}]]], "\[Sigma]"}]}], "=", 
     RowBox[{
      FractionBox["x", "\[Sigma]"], "+", 
      RowBox[{
       FractionBox[
        RowBox[{"1", "+", "\[Kappa]"}], "\[Kappa]"], 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["\[Sigma]", 
          FractionBox["\[Kappa]", 
           RowBox[{"1", "+", "\[Kappa]"}]]], "-", "1"}], ")"}]}]}]}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8c5c8939-82a6-43a1-95f4-ad576edc1cab"]
}], "Text",
