            SuperscriptBox["W", 
             RowBox[{"1", "+", "a"}]]}]], "]"}]}], ",", "d"}], "]"}], 
      RowBox[{"GHanelMod", "[", 
       RowBox[{
        RowBox[{"W", " ", 
         RowBox[{"gHanelMod", "[", 
          FractionBox["1", 
           RowBox[{" ", "W"}]], "]"}]}], ",", "d"}], "]"}]], ",", 
     RowBox[{"W", "->", "\[Infinity]"}]}], "]"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
