Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Assuming", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "d"]}], "<", "\[Kappa]", "<", "0"}], "&&", 
    RowBox[{"d", ">", "0"}], "&&", 
    RowBox[{"\[Alpha]", ">", "0"}], "&&", 
    RowBox[{"\[Kappa]", "\[Element]", "Reals"}], "&&", 
    RowBox[{"d", "\[Element]", "Reals"}], "&&", 
    RowBox[{"\[Alpha]", "\[Element]", "Reals"}], "&&", 
    RowBox[{"\[Gamma]", "\[Element]", "Reals"}], "&&", 
    RowBox[{"a", ">", "0"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"Limit", "[", 
    RowBox[{
     RowBox[{
      FractionBox[
       RowBox[{"G", "[", 
        RowBox[{
         RowBox[{
          SuperscriptBox["W", 
           RowBox[{"1", "+", "a"}]], " ", 
          RowBox[{"g", "[", 
           RowBox[{
            FractionBox["1", 
             SuperscriptBox["W", 
              RowBox[{"1", "+", "a"}]]], ",", "\[Kappa]", ",", "\[Alpha]", ",",
             "d"}], "]"}]}], ",", "\[Alpha]"}], "]"}], 
       RowBox[{"G", "[", 
        RowBox[{
         RowBox[{"W", " ", 
          RowBox[{"g", "[", 
           RowBox[{
            FractionBox["1", 
             RowBox[{" ", "W"}]], ",", "\[Kappa]", ",", "\[Alpha]", ",", 
            "d"}], "]"}]}], ",", "\[Alpha]"}], "]"}]], 
      SuperscriptBox["W", 
       RowBox[{
        RowBox[{"-", "a"}], 
        FractionBox[
         RowBox[{"1", "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"d", "+", "\[Alpha]"}], ")"}], " ", "\[Kappa]"}]}], 
         RowBox[{"\[Alpha]", "+", 
          RowBox[{"d", " ", "\[Alpha]", " ", "\[Kappa]"}]}]]}]]}], ",", 
     RowBox[{"W", "->", "\[Infinity]"}]}], "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.983252261020279*^9, 3.983252274671463*^9}, {
  3.983252317943235*^9, 3.9832523460740023`*^9}, {3.98325274282514*^9, 
  3.9832527493788567`*^9}, {3.983254361902521*^9, 3.983254367820003*^9}},
 CellLabel->"In[57]:=",ExpressionUUID->"76d4a35d-d9b0-48da-8012-47970c8fe4d2"],

