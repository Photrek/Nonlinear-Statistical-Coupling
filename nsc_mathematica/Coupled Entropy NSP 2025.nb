146a864c794b"],

Cell[TextData[{
 "Then the scaling ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Lambda]", 
    RowBox[{"1", "-", "c"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "69f00cb1-666f-4f01-8d43-8e6b2befaba3"],
 " gives c =",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     FractionBox[
      RowBox[{"d", " ", "\[Alpha]"}], "\[Gamma]"]}], 
    FractionBox["\[Kappa]", 
     RowBox[{"1", "+", 
      RowBox[{"d", " ", "\[Kappa]"}]}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f58afa1e-f250-4ede-bba7-1d025ceccc79"]
}], "Text",
