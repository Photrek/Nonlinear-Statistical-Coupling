}, Closed]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"1", "+", 
    FractionBox[
     RowBox[{"\[Alpha]", " ", 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["x", "\[Alpha]"], "-", 
        SuperscriptBox["\[Sigma]", "\[Alpha]"]}], ")"}]}], 
     RowBox[{
