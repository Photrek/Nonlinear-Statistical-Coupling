Cell[BoxData[
 RowBox[{"ProbabilityDistribution", "[", 
  RowBox[{"ComplexInfinity", ",", 
   RowBox[{"{", 
    RowBox[{"\[FormalX]", ",", "\[Kappa]", ",", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"\[Sigma]", "\[GreaterEqual]", "0"}], ",", "\[Infinity]", ",", 
       
       RowBox[{
