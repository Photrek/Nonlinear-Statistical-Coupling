     RowBox[{"x", "\[Element]", "Reals"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{
     SubsuperscriptBox["\[Integral]", "x", "\[Infinity]"], 
     RowBox[{
      FractionBox[
       RowBox[{"\[Alpha]", " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"\[Kappa]", "/", "\[Alpha]"}], ")"}], 
         RowBox[{"1", "/", "\[Alpha]"}]]}], 
       RowBox[{"2", "\[Sigma]", " ", 
        RowBox[{"Beta", "[", 
         RowBox[{
          FractionBox["1", "\[Alpha]"], ",", 
          FractionBox["1", "\[Kappa]"]}], "]"}]}]], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{
          FractionBox[
           RowBox[{"\[Kappa]", " "}], "\[Alpha]"], 
          SuperscriptBox[
           RowBox[{"(", 
            FractionBox["t", "\[Sigma]"], ")"}], "\[Alpha]"]}]}], ")"}], 
       RowBox[{"-", " ", 
        RowBox[{"(", 
         RowBox[{
          FractionBox["1", "\[Alpha]"], "+", 
          FractionBox["1", "\[Kappa]"]}], ")"}]}]], 
      RowBox[{"\[DifferentialD]", "t"}]}]}]}], "]"}], "//", 
  "FullSimplify"}]], "Input",
 CellChangeTimes->{{3.985767727987486*^9, 3.9857677867790613`*^9}, {
  3.985768257368474*^9, 3.98576827215906*^9}, {3.985768419293952*^9, 
