Cell[BoxData[
 TemplateBox[{
   FractionBox[
    RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"-", 
         FractionBox[
          RowBox[{"\[ImaginaryI]", " ", "\[Pi]"}], "\[Kappa]"]}]], " ", 
      SuperscriptBox[
       RowBox[{"(", 
         FractionBox["\[Alpha]", "\[Kappa]"], ")"}], 
       FractionBox["1", "\[Alpha]"]], " ", 
      SuperscriptBox[
       RowBox[{"(", 
         FractionBox["\[Kappa]", "\[Alpha]"], ")"}], 
       FractionBox["1", "\[Alpha]"]], " ", 
      RowBox[{"Beta", "[", 
        RowBox[{
          RowBox[{"-", 
            FractionBox[
             RowBox[{"\[Alpha]", " ", 
               SuperscriptBox[
                RowBox[{"(", 
                  FractionBox["\[Sigma]", "x"], ")"}], "\[Alpha]"]}], 
             "\[Kappa]"]}], ",", 
          FractionBox["1", "\[Kappa]"], ",", 
          RowBox[{"1", "-", 
            FractionBox["1", "\[Alpha]"], "-", 
            FractionBox["1", "\[Kappa]"]}]}], "]"}]}], 
    RowBox[{"2", " ", 
      RowBox[{"Beta", "[", 
        RowBox[{
          FractionBox["1", "\[Alpha]"], ",", 
          FractionBox["1", "\[Kappa]"]}], "]"}]}]], 
   RowBox[{
     RowBox[{"x", ">", 
       RowBox[{"\[Sigma]", " ", 
         RowBox[{"Re", "[", 
           SuperscriptBox[
            RowBox[{"(", 
              RowBox[{"-", 
                FractionBox["\[Alpha]", "\[Kappa]"]}], ")"}], 
            FractionBox["1", "\[Alpha]"]], "]"}]}]}], "||", 
     RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
          RowBox[{"-", 
            FractionBox["\[Alpha]", "\[Kappa]"]}], ")"}], 
        FractionBox["1", "\[Alpha]"]], "\[NotElement]", 
       TemplateBox[{}, "Reals"]}]}]},
  "ConditionalExpression"]], "Output",
 CellChangeTimes->{3.9857683895515223`*^9, 3.985768549350985*^9, 
  3.985768607361953*^9},
