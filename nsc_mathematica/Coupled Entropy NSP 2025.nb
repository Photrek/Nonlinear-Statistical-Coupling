Cell[TextData[{
 "Old definition moments below ",
 Cell[BoxData[
  FormBox[
   RowBox[{"m", "<", 
    FractionBox["1", 
     OverscriptBox["\[Kappa]", "~"]], " "}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9a9587a5-6921-473f-910c-ea4e929121a0"],
 "are finite.\nNew definition moments below ",
 Cell[BoxData[
  RowBox[{"m", "<", 
   FractionBox["\[Alpha]", "\[Kappa]"]}]],ExpressionUUID->
  "0436a0c0-fed9-4a56-8d3d-375b26539292"],
 "or ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["m", "\[Alpha]"], "<", "\[Kappa]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "12b8c00a-d0b4-4829-8c92-f1c08931bd75"],
 ".  If \[Kappa] < 1, then m <= \[Alpha] is finite."
}], "Text",
 CellChangeTimes->{{3.986007041904379*^9, 3.9860071963668613`*^9}, {
  3.986007272803397*^9, 3.9860074281574373`*^9}, {3.986007487367227*^9, 
