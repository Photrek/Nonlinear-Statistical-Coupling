      FractionBox[
       RowBox[{"G", "[", 
        RowBox[{
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"\[Lambda]", " ", "W"}], ")"}], "d"], " ", 
          RowBox[{"gLogLog", "[", 
           FractionBox["1", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"\[Lambda]", " ", "W"}], ")"}], "d"]], "]"}]}], ",", 
         "\[Alpha]"}], "]"}], 
       RowBox[{"G", "[", 
