Cell[CellGroupData[{

Cell["Scaling of q-Entropy", "Subsection",
 CellChangeTimes->{{3.973351825046336*^9, 
  3.97335183017785*^9}},ExpressionUUID->"66c1487f-8c20-4501-bfb4-\
6d791f030535"],

Cell[TextData[{
 "Tsallis entropy is defined to be ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["S", "q"], "(", "p", ")"}], "=", 
    RowBox[{
     RowBox[{
      FractionBox["1", 
       RowBox[{"q", "-", "1"}]], 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"i", "=", "1"}], "N"], 
         SuperscriptBox[
          SubscriptBox["p", "i"], "q"]}]}], ")"}]}], "=", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"i", "=", "1"}], "N"], 
      RowBox[{
       FractionBox["1", 
        RowBox[{"q", "-", "1"}]], 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["p", "i"], "-", 
         SuperscriptBox[
          SubscriptBox["p", "i"], "q"]}], ")"}]}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a3694c90-0e92-4d02-ad50-612386d0422b"],
 ". Determine the c scaling of the Tsallis entropy and compare that with the \
Hanel, Thurner published record that c = q for q<1 and c=1 for q>1. \
gTsallis(x) =",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", 
     RowBox[{"q", "-", "1", " "}]], 
    RowBox[{"(", 
     RowBox[{"x", "-", 
      SuperscriptBox["x", "q"]}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "8d4cff6e-7f6e-48ea-a746-aacfca76911d"]
}], "Text",
 CellChangeTimes->{{3.973351834598881*^9, 3.973351856878862*^9}, {
  3.9733519361020613`*^9, 3.973351946211767*^9}, {3.9733519882283297`*^9, 
  3.973352091407436*^9}, {3.973352172325397*^9, 3.973352195511695*^9}, {
  3.973352393439377*^9, 3.9733524472192297`*^9}, {3.973354132158033*^9, 
  3.973354197037043*^9}},ExpressionUUID->"ee7e3a85-b2f0-4953-8f49-\
5be4ac1f606a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"gTsallis", "[", 
   RowBox[{"x_", ",", "q_"}], "]"}], ":=", 
  RowBox[{
   FractionBox["1", 
    RowBox[{"q", "-", "1"}]], 
   RowBox[{"(", 
    RowBox[{"x", "-", 
     SuperscriptBox["x", "q"]}], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.97335235476772*^9, 3.97335236076488*^9}, {
  3.973352454868004*^9, 3.97335248639902*^9}, {3.973354200521492*^9, 
  3.973354200595924*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"5d479dec-ffe4-4705-94af-7c880fdcf38b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Assuming", "[", 
  RowBox[{
   RowBox[{"0", "<", "q", "<", "1"}], ",", 
   RowBox[{"Limit", "[", 
    RowBox[{
     FractionBox[
      RowBox[{"\[Lambda]", " ", "W", " ", 
       RowBox[{"gTsallis", "[", 
        RowBox[{
         FractionBox["1", 
          RowBox[{"\[Lambda]", " ", "W"}]], ",", "q"}], "]"}]}], 
      RowBox[{"W", " ", 
       RowBox[{"gTsallis", "[", 
        RowBox[{
         FractionBox["1", 
          RowBox[{" ", "W"}]], ",", "q"}], "]"}]}]], ",", 
     RowBox[{"W", "->", "\[Infinity]"}]}], "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.97335230397987*^9, 3.973352350038306*^9}, {
  3.973352569075535*^9, 3.973352603727779*^9}, {3.973354240407302*^9, 
  3.97335424049339*^9}, {3.9733542857509823`*^9, 3.973354286511282*^9}, {
