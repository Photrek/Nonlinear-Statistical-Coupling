Cell[BoxData[
 TagBox[GridBox[{
    {"\[Piecewise]", GridBox[{
       {"\[Infinity]", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"x", "\[Element]", 
            TemplateBox[{},
             "Reals"]}], "&&", 
           RowBox[{
            RowBox[{"-", "1"}], "\[LessEqual]", "\[Kappa]", "<", "0"}], "&&", 
           
           RowBox[{
            RowBox[{"x0", " ", "\[Kappa]"}], "<", 
            RowBox[{"-", "1"}]}]}], ")"}], "||", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"x0", "\[Element]", 
            TemplateBox[{},
             "Reals"]}], "&&", 
           RowBox[{"\[Kappa]", "\[NotEqual]", "0"}], "&&", 
           RowBox[{
            RowBox[{"x0", " ", "\[Kappa]"}], "\[Equal]", 
            RowBox[{"-", "1"}]}], "&&", 
           RowBox[{
            RowBox[{"x", " ", "\[Kappa]"}], "\[LessEqual]", 
            RowBox[{"-", "1"}]}], "&&", 
           RowBox[{
            RowBox[{"-", "1"}], "\[LessEqual]", "\[Kappa]", "<", "0"}]}], 
          ")"}]}]},
       {
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"x", "-", "x0"}], ")"}], " ", "\[Kappa]"}], ")"}], 
          FractionBox["1", "\[Kappa]"]], " ", 
         RowBox[{"(", 
          InterpretationBox[
           RowBox[{
            RowBox[{"\[Kappa]", " ", 
             RowBox[{"(", 
              RowBox[{"x", "-", "x0"}], ")"}]}], "+", 
            InterpretationBox[
             SuperscriptBox[
              RowBox[{"O", "[", 
               RowBox[{"x", "-", "x0"}], "]"}], "5"],
             SeriesData[$CellContext`x, $CellContext`x0, {}, 1, 5, 1],
             Editable->False]}],
           
           SeriesData[$CellContext`x, $CellContext`x0, \
{$CellContext`\[Kappa]}, 1, 5, 1],
           Editable->False], ")"}]}], 
        RowBox[{
         RowBox[{"x0", "\[Element]", 
          TemplateBox[{},
           "Reals"]}], "&&", 
         RowBox[{"\[Kappa]", "\[NotEqual]", "0"}], "&&", 
         RowBox[{
          RowBox[{"x0", " ", "\[Kappa]"}], "\[Equal]", 
          RowBox[{"-", "1"}]}], "&&", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"\[Kappa]", ">", "0"}], "&&", 
             RowBox[{
              RowBox[{"x", " ", "\[Kappa]"}], ">", 
              RowBox[{"-", "1"}]}]}], ")"}], "||", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"\[Kappa]", "<", "0"}], "&&", 
             RowBox[{
              RowBox[{"x", " ", "\[Kappa]"}], ">", 
              RowBox[{"-", "1"}]}]}], ")"}]}], ")"}]}]},
       {
        InterpretationBox[
         RowBox[{
          SuperscriptBox["\[ExponentialE]", "x0"], "+", 
